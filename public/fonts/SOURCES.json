{
  "why": "Vendored so a printed CV never depends on a third-party font fetch, and STATIC so Chromium can embed them. Google Fonts serves Sora and Manrope as variable fonts only; Skia cannot embed a variable-font instance and writes Type 3 fonts instead, whose glyph boxes are the whole em square -- which made pdftotext extract a candidate's name out of order. See the @font-face block in src/styles.css.",
  "licence": "SIL Open Font Licence 1.1 (see OFL.txt). Sora and Manrope by their respective authors.",
  "derivedFrom": [
    "https://raw.githubusercontent.com/google/fonts/main/ofl/sora/Sora%5Bwght%5D.ttf",
    "https://raw.githubusercontent.com/google/fonts/main/ofl/manrope/Manrope%5Bwght%5D.ttf"
  ],
  "howToReDerive": [
    "fonttools varLib.instancer -o <Family>-<w>.ttf <Family>[wght].ttf wght=<w>",
    "pyftsubset <Family>-<w>.ttf --unicodes=<the unicode-range in styles.css, commas not spaces> --layout-features='*' --flavor=woff2 --output-file=<family>-<w>.woff2"
  ],
  "derivedAt": "2026-09-08",
  "subset": "latin + latin-ext, which covers Swedish and English",
